{
  "name": "@aomex-contrib/playwright",
  "version": "0.3.0",
  "description": "基于 Playwright 的浏览器服务",
  "repository": "git@github.com:aomex/aomex-contrib.git",
  "homepage": "https://aomex.js.org",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "prepublishOnly": "tsdown"
  },
  "types": "src/index.ts",
  "exports": "./src/index.ts",
  "files": [
    "dist",
    "LICENSE",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "peerDependencies": {
    "@aomex/common": "^4.7.0",
    "@aomex/logger": "^4.7.0",
    "playwright": "^1.40.0"
  },
  "dependencies": {
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-recaptcha": "^3.6.8",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@aomex/common": "^4.7.0",
    "@aomex/logger": "^4.7.0",
    "@types/debug": "^4.1.13",
    "playwright": "^1.65.1"
  }
}
