    "@aomex/common": "^4.7.0",
    "@aomex/web": "^4.7.0"
  },
  "devDependencies": {
    "@aomex/cache": "^4.7.0",
    "@aomex/common": "^4.7.0",
    "@aomex/web": "^4.7.0"
  }
}
