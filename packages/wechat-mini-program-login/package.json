{
  "name": "@aomex-contrib/wechat-mini-program-login",
  "version": "1.0.0",
  "description": "微信小程序 / 小游戏登录与手机号（jscode2session + access_token + getPhoneNumber，非 OAuth2）",
  "repository": "git@github.com:aomex/aomex-contrib.git",
  "homepage": "https://aomex.js.org",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
