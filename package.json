{
  "name": "aomex-contrib",
  "private": true,
  "description": "Aomex 周边包（厂商预设、非核心集成等）",
  "repository": "git@github.com:aomex/aomex-contrib.git",
  "homepage": "https://aomex.js.org",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "build": "node scripts/remove-dist.mjs && pnpm --recursive --workspace-concurrency 1 prepublishOnly",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "ts-expect": "^1.3.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.0",
    "vitest": "^5.1.0"
  }
}
